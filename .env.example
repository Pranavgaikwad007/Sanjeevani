# Local server
PORT=4173
DEMO_PASSWORD=change-this-demo-password
SESSION_SECRET=replace-with-a-long-random-string

# Optional Supabase readiness configuration.
# The current local adapter remains the default until the migration is applied
# and a persistence adapter is selected for your Supabase project.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Optional routing provider. Leave empty to use the clearly labelled simulated route fallback.
OSRM_BASE_URL=
